# =============================================================================
# Variáveis para os exemplos em examples/compose/ e examples/server/
# Copie para a pasta do exemplo (ex.: examples/server/.env) e preencha.
# Formato: CHAVE=valor, sem aspas (compatível com docker --env-file).
# NUNCA commite o .env real.
# =============================================================================

# Obrigatório: URL do script Python que o worker executa
SCRIPT_URL=https://example.com/scripts/my_automation.py

# Opcional: scripts auxiliares (separados por vírgula), salvos em /app/src
HELPER_URLS=

# Opcional: .zip com profile do Chrome baixado no boot
CHROME_PROFILE_URL=

# Identificação do worker (examples/compose; em examples/server cada worker tem o seu)
WORKER_ID=rpa-worker-01

# examples/server: imagem e overrides opcionais por worker (NN = 01, 02, ...)
# RPA_IMAGE=ghcr.io/nailtongomes/rpa-worker-selenium:latest
# SCRIPT_URL_03=https://example.com/scripts/outro_script.py
# CHROME_PROFILE_URL_02=https://example.com/profiles/worker-02.zip

# Segredos usados pelos scripts de automação
N3_API_BASE_URL=
N3_TOKEN=
SENHA_TOKEN_A1=
SECRET_2FA_CNJ=

# Modo standby (docker-compose.standby.yml)
TASK_AUTH_TOKEN=
